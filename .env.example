DATABASE_URL="postgresql://user:password@localhost:5432/budget?schema=public"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-value"
NEXTAUTH_URL="http://localhost:3000"

# optional: enables "Continue with Google" on the login/sign-up pages.
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials,
# with authorized redirect URI <origin>/api/auth/callback/google. Left unset, the
# Google option is hidden and email/password sign-up still works.
# AUTH_GOOGLE_ID="your-client-id"
# AUTH_GOOGLE_SECRET="your-client-secret"

# used only by `npm run prisma:bootstrap-admin`, an optional convenience for
# seeding a known dev account — not required, anyone can sign up from /signup
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
