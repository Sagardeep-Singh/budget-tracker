DATABASE_URL="postgresql://user:password@localhost:5432/budget?schema=public"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-value"
NEXTAUTH_URL="http://localhost:3000"

# optional: enables "Continue with Google" on the login/sign-up pages.
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials,
# with authorized redirect URI <origin>/api/auth/callback/google. Left unset, the
# Google option is hidden and email/password sign-up still works.
# AUTH_GOOGLE_ID="your-client-id"
# AUTH_GOOGLE_SECRET="your-client-secret"

# used only by `npm run prisma:bootstrap-admin`, an optional convenience for
# seeding a known dev account — not required, anyone can sign up from /signup
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# set to "true" to show demo login credentials on /login, and to let the
# /api/admin/reseed-demo cron route actually reseed (it no-ops otherwise,
# even with a valid CRON_SECRET) — a single on/off switch for demo mode.
# DEMO_ENABLED="true"

# used only by `npm run prisma:seed:demo` and the /api/admin/reseed-demo
# cron route — a large, deterministic demo dataset for one fixed user.
# Every write is scoped to this one user; it never touches other accounts.
# DEMO_EMAIL="demo@ledger.app"
# DEMO_PASSWORD="replace-with-a-strong-password"

# required in production to authorize the periodic demo reseed
# (see docs/feature-plans/demo-seed-cron.md and vercel.json). Generate with
# `openssl rand -hex 32`. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET` once this is set as a project env var.
# CRON_SECRET="replace-with-a-long-random-value"
