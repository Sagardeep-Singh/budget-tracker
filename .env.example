DATABASE_URL="postgresql://user:password@localhost:5432/budget?schema=public"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-value"
NEXTAUTH_URL="http://localhost:3000"

# optional: enables "Continue with Google" on the login/sign-up pages.
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials,
# with authorized redirect URI <origin>/api/auth/callback/google. Left unset, the
# Google option is hidden and email/password sign-up still works.
# AUTH_GOOGLE_ID="your-client-id"
# AUTH_GOOGLE_SECRET="your-client-secret"

# optional: enables the reminders card in Settings and the daily reminder cron.
# Generate a key pair with `npx web-push generate-vapid-keys`. The public key is
# used both in the browser (pushManager.subscribe) and on the server (web-push),
# so it is one NEXT_PUBLIC_ var rather than two that could drift. VAPID_SUBJECT is
# the mailto:/https: contact the Web Push spec requires. Left unset, Settings says
# reminders aren't available on this deployment and the cron run is a no-op.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID_SUBJECT="mailto:you@example.com"

# optional: enables the "AI categorization" card in Settings and the per-row
# "Suggest with AI" action in the Categorize queue. 32 random bytes, base64:
# `openssl rand -base64 32`. It encrypts each user's bring-your-own provider API
# key at rest (AES-256-GCM, with the userId as additional authenticated data).
# Server-only — never NEXT_PUBLIC_, never returned by any API response, never in
# a data export. Left unset, Settings says AI suggestions aren't available on
# this deployment and the suggest endpoint answers 503. Rotating it without
# migrating stored keys makes every saved key unreadable — see
# docs/runbooks/rotate-secret-encryption-key.md.
# SECRET_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"

# test-only: override where the Anthropic/OpenAI adapters send their outbound
# calls, so the e2e suite can point them at a local fixture server. Read once at
# module load from deploy config only — never from request input, so this is not
# a user-reachable SSRF surface. Leave unset in any real deployment; the
# adapters default to the real provider APIs.
# AI_ANTHROPIC_BASE_URL="http://127.0.0.1:4599"
# AI_OPENAI_BASE_URL="http://127.0.0.1:4599"

# bearer token Vercel Cron sends on its scheduled call to /api/cron/reminders, and
# what you pass by hand to test it. Unset, the cron route fails closed with a 500
# rather than running unauthenticated.
# CRON_SECRET="replace-with-a-random-value"

# used only by `npm run prisma:bootstrap-admin`, an optional convenience for
# seeding a known dev account — not required, anyone can sign up from /signup
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
